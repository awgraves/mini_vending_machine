		(uuid "8097a497-3603-4203-9ac1-b8a8fcba42d1")
	)
	(text "For the 6 pairs of IR breakbeam modules across cubby dispensers.\n\nRunning the IR beams off the 5v rail would require logic level shifting. \nUsing 3v3 instead allows direct interfacing with the MCU GPIO pins.\n\nEach pair requires about 20mA, so 6 pairs would exceed the 100mA limit \nof the blackpill's onboard LDO, \nhence a dedicated 3v3 buck converter for additional supply."
		(exclude_from_sim no)
		(at 72.39 87.376 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "9b2efd19-3812-45b5-add2-2119659390ca")
	)
