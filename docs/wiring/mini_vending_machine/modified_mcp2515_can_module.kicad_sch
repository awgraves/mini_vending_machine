	)
	(text "Modifications to pre-fab module:\n1. Cut PCB trace on bottom to disconnect TJA1050 VCC from MCP2515 VCC\n2. Solder jumper wire from TJA1040 VCC to a separate +5v header pin\n\nThis allows separate +3v3 logic and +5V CAN transceiver levels."
		(exclude_from_sim no)
		(at 145.542 49.784 0)
