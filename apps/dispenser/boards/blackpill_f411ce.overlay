#include <zephyr/dt-bindings/pinctrl/stm32-pinctrl.h>

/ {

  chosen {
    zephyr,console = &cdc_acm_uart0;
    zephyr,shell-uart = &cdc_acm_uart0;
  };

  aliases {
    led = &user_led;

    beama = &beama;
    beamb = &beamb;
    beamc = &beamc;
    beamd = &beamd;
    beame = &beame;
    beamf = &beamf;

    motora = &motora;
    motorb = &motorb;
    motorc = &motorc;
    motord = &motord;
    motore = &motore;
    motorf = &motorf;
  };

  switches {
    compatible = "gpio-keys";

     beama: beam_a {
       gpios = <&gpiob 9 GPIO_ACTIVE_LOW>;
     };
     beamb: beam_b {
       gpios = <&gpiob 8 GPIO_ACTIVE_LOW>;
     };
     beamc: beam_c {
       gpios = <&gpiob 7 GPIO_ACTIVE_LOW>;
     };
     beamd: beam_d {
       gpios = <&gpiob 6 GPIO_ACTIVE_LOW>;
     };
     beame: beam_e {
       gpios = <&gpiob 5 GPIO_ACTIVE_LOW>;
     };
     beamf: beam_f {
       gpios = <&gpiob 4 GPIO_ACTIVE_LOW>;
     };
  };

  motors {
    compatible = "gpio-motor-ctrls";

    motora: motor_a {
      gpios = <&gpiob 3 GPIO_ACTIVE_HIGH>;
    };
    motorb: motor_b {
      gpios = <&gpioa 15  GPIO_ACTIVE_HIGH>;
    };
    motorc: motor_c {
      gpios = <&gpioa 8 GPIO_ACTIVE_HIGH>;
    };
    motord: motor_d {
      gpios = <&gpiob 15 GPIO_ACTIVE_HIGH>;
    };
    motore: motor_e {
      gpios = <&gpioa 10 GPIO_ACTIVE_HIGH>;
    };
    motorf: motor_f {
      gpios = <&gpioa 9 GPIO_ACTIVE_HIGH>;
    };
  };
};

&usart1 {
  status = "disabled";
};

/* 
  Other SPI1 pins:
  PA5 CLK
  PA6 MISO
  PA7 MOSI
*/
&spi1 {
    status = "okay";
    cs-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>;    

    mcp2515: mcp2515@0 {
        compatible = "microchip,mcp2515";
        reg = <0x0>;
        spi-max-frequency = <8000000>;
        int-gpios = <&gpiob 1 GPIO_ACTIVE_LOW>;
        osc-freq = <8000000>; /* 8 MHz crystal */
        status = "okay";
    };
};

&i2c1 {
  status = "disabled";
};

&zephyr_udc0 {
  cdc_acm_uart0: cdc_acm_uart0 {
    compatible = "zephyr,cdc-acm-uart";
  };
};
