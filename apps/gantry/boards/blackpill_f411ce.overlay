#include <zephyr/dt-bindings/pinctrl/stm32-pinctrl.h>

/ {
  chosen {
    zephyr,console = &cdc_acm_uart0;
    zephyr,shell-uart = &cdc_acm_uart0;
  };

  aliases {
    my-joystick = &joystick;
    red-pwm-led = &red_led;
    yellow-pwm-led = &yellow_led;
  };

  joystick: joystick {
    compatible = "joystick";
    io-channels = <&adc1 1 &adc1 2>;
    io-channel-names = "x", "y";
  };

  pwmleds {
    compatible = "pwm-leds";

    red_led: red-led {
      pwms = <&pwm4 1 20000 PWM_POLARITY_NORMAL>;
    };

    yellow_led: yellow-led {
      pwms = <&pwm4 2 20000 PWM_POLARITY_NORMAL>;
    };
  };
};

&usart1 {
  status = "disabled";
};

&zephyr_udc0 {
  cdc_acm_uart0: cdc_acm_uart0 {
    compatible = "zephyr,cdc-acm-uart";
  };
};

&pinctrl {
  adc1_in2_pa2: adc1_in2_pa2 {
    pinmux = <STM32_PINMUX('A', 2, ANALOG)>;
  };
};

#define JOYSTICK_ADC_COMMON \
    zephyr,gain = "ADC_GAIN_1"; \
    zephyr,reference = "ADC_REF_INTERNAL"; \
    zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; \
    zephyr,resolution = <12>;

&adc1 {
  #address-cells = <1>;
  #size-cells = <0>;
  pinctrl-0 = <&adc1_in1_pa1>, < &adc1_in2_pa2 >;

  channel@1 {
    reg = <1>;
    JOYSTICK_ADC_COMMON
  };

  channel@2 {
    reg = <2>;
    JOYSTICK_ADC_COMMON
  };
};

&timers4 {
  status = "okay";
};
