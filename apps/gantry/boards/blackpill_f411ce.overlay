#include <zephyr/dt-bindings/pinctrl/stm32-pinctrl.h>

/ {
  chosen {
    zephyr,console = &cdc_acm_uart0;
    zephyr,shell-uart = &cdc_acm_uart0;
  };

  aliases {
    my-joystick = &joystick;
    red-pwm-led = &red_led;
    yellow-pwm-led = &yellow_led;
    stepper-driver = &tmc2209;
    stepper-ctrl = &step_dir_motion_control;
  };

  joystick: joystick {
    compatible = "joystick";
    io-channels = <&adc1 1 &adc1 2>;
    io-channel-names = "x", "y";
  };

  pwmleds {
    compatible = "pwm-leds";

    red_led: red-led {
      pwms = <&pwm4 1 20000 PWM_POLARITY_NORMAL>;
    };

    yellow_led: yellow-led {
      pwms = <&pwm4 2 20000 PWM_POLARITY_NORMAL>;
    };
  };

  tmc2209: stepper-driver {
    compatible = "adi,tmc2209";
    en-gpios = <&gpioa 3 GPIO_ACTIVE_LOW>; // double check this
    m0-gpios = <&gpioa 4 GPIO_ACTIVE_HIGH>;
    m1-gpios = <&gpioa 5 GPIO_ACTIVE_HIGH>;
    micro-step-res = <8>;
  };

  step_dir_motion_control: motion-controller {
    compatible = "zephyr,gpio-step-dir-stepper-ctrl";
    step-gpios = <&gpioa 6 GPIO_ACTIVE_HIGH>;
    dir-gpios = <&gpioa 7 GPIO_ACTIVE_HIGH>;
    counter = <&counter1>;
    invert-direction;
    stepper-driver = <&tmc2209>;
  };
};

&usart1 {
  status = "disabled";
};

&zephyr_udc0 {
  cdc_acm_uart0: cdc_acm_uart0 {
    compatible = "zephyr,cdc-acm-uart";
  };
};

&pinctrl {
  adc1_in2_pa2: adc1_in2_pa2 {
    pinmux = <STM32_PINMUX('A', 2, ANALOG)>;
  };
};

#define JOYSTICK_ADC_COMMON \
    zephyr,gain = "ADC_GAIN_1"; \
    zephyr,reference = "ADC_REF_INTERNAL"; \
    zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; \
    zephyr,resolution = <12>;

&adc1 {
  #address-cells = <1>;
  #size-cells = <0>;
  pinctrl-0 = <&adc1_in1_pa1>, < &adc1_in2_pa2 >;

  channel@1 {
    reg = <1>;
    JOYSTICK_ADC_COMMON
  };

  channel@2 {
    reg = <2>;
    JOYSTICK_ADC_COMMON
  };
};

&timers2 {
  status="okay";
  st,prescaler = <2>;

  interrupts = <28 0>;
  interrupt-names = "global";

  counter1: counter {
    status="okay";
  };
};

&timers4 {
  status = "okay";
};
