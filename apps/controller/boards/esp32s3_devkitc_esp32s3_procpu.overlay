
/ {

  chosen {
    zephyr,display = &lcd;	
  };

  mipi_dbi {
    compatible = "zephyr,mipi-dbi-spi";
	spi-dev = <&spi2>;
	dc-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
	reset-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
	write-only;

	#address-cells = <1>;
	#size-cells = <0>;
 	
	lcd: st7796s@0 {
		reg = <0>;
		compatible = "sitronix,st7796s";	
		mipi-max-frequency = <40000000>; // 40 MHZ
		
		/* PGC and NGC values copied from https://github.com/Bodmer/TFT_eSPI/blob/16e37595040eac69cd628e4bffb56fc30cad6299/TFT_Drivers/ST7796_Init.h#L61 */
		pgc = [F0 09 0b 06 04 15 2F 54 42 3C 17 14 18 1B];
		ngc = [E0 09 0B 06 04 03 2B 43 42 3B 16 14 17 1B];

		// madctl pg. 183 of https://www.displayfuture.com/Display/datasheet/controller/ST7796s.pdf
		// Setting for landscape mode with mcu to mem col/row pixel direction.
		// (MY, MX, and MV bits set + BGR bit == 0xE8)
		madctl = <0xE8>;
		height = <320>;
		width = <480>;
	};
  };

  touch_input: touch_input {
	compatible = "zephyr,lvgl-pointer-input";
	input = <&ft6336>;
	invert-x;
  };
};

/*
 NOTE: GPIO 35, 36, 37 are taken for external PSRAM.

 See pg. 31 of https://documentation.espressif.com/esp32-s3_datasheet_en.pdf
*/

/*
 pg. 27 of esp32-s3 datasheet shows periph pin assignments.

 SPI 0/1 are mainly internal buses. SPI 2/3 are for general purpose.
  See: https://documentation.espressif.com/esp32-s3_technical_reference_manual_en.pdf#spi

 Default SPI2 pins are:
  - CS: 10
  - MOSI: 11
  - CLK: 12

 And for other LCD pins:
  - LCD_RS: 9
  - LCD_RST: 14

 For I2C (for capacitive touch), many options.
 Can use pins on same side of board as SPI 2:
  - CTP_INT: 4
  - CTP_SDA: 5
  - CTP_RST: 6
  - CTP_SCL: 7
 I2C addr is 0x38 per https://manuals.plus/asin/B0CRGQN58D.pdf pg 11

 TWAI (CAN) has many options.
 To place on opposite side of board from LCD:
 - TX: 1
 - RX: 2
*/

&spi2 {
    pinctrl-0 = <&spim2_default>;
    pinctrl-names = "default";
	status = "okay";
};

&pinctrl {
	i2c0_custom: i2c0_custom {
		group1 {
			pinmux = <I2C0_SDA_GPIO5>, <I2C0_SCL_GPIO7>;
			bias-pull-up;
			drive-open-drain;
			output-high;	
		};
	};
};

&i2c0 {
	status = "okay";
	pinctrl-0 = < &i2c0_custom >;
	pinctrl-names = "default";

	ft6336: ft6336@38 {
		compatible = "focaltech,ft5336"; // handles ft6336 as well
		reg = <0x38>;
		// NOTE: the interrupt for ft6336 is only when finger is pressed
		// so it misses the release signals
		// By not specifying an int gpio, the driver will use polling instead
		// int-gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
		reset-gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;

		screen-height = <320>;
		screen-width = <480>;
		// swapped-x-y;
	};
};
